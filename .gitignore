# Secrets — must stay ignored. `.env` holds live API keys.
# Deny-by-default: any new .env.<whatever> is ignored unless explicitly excepted below.
.env*
!.env.example

# Dependencies
node_modules/

# Yarn 4 (nodeLinker: node-modules) — keep the release binary, ignore the caches
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
.pnp.*

# Next.js
.next/
out/
next-env.d.ts

# Storybook — public/storybook is a build artifact produced by `yarn build-storybook`
/public/storybook
/storybook-static

# Test / build output
coverage/
*.tsbuildinfo

# Unsplash response cache — lets `yarn data:quotes` resume for free after the
# hourly rate limit refills. Regenerable, so it stays out of the repo.
.cache/

# Editors & OS
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude settings
.claude/settings.json