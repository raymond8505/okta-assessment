# Copy to .env for local development. .env is gitignored; this file is not.
#
# The scaffold itself needs no environment variables — PORT and HOSTNAME are
# baked into the Dockerfile. This file documents what the application will need
# as it grows.
#
# When adding a variable:
#   1. add it here with a placeholder
#   2. add it to the .env heredoc in .github/workflows/deploy.yml
#   3. add a matching GitHub Actions secret
# docker-compose uses `env_file`, so it forwards new variables automatically —
# there is nothing to add there.

# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your-unsplash-access-key-here
